apiVersion: v1
kind: Secret
metadata:
  name: app-db
  namespace: shop
  labels:
    app.kubernetes.io/part-of: fastapi-pool-mvp
type: Opaque
stringData:
  DB_HOST: postgres
  DB_PORT: "5432"
  DB_USER: ${DB_USER}
  DB_PASS: ${DB_PASS}
  DB_NAME: ${DB_NAME}
  POSTGRES_USER: ${DB_USER}
  POSTGRES_PASSWORD: ${DB_PASS}
  POSTGRES_DB: ${DB_NAME}
