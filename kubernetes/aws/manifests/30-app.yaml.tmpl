apiVersion: apps/v1
kind: Deployment
metadata:
  name: order-api
  namespace: shop
  labels:
    app: order-api
spec:
  replicas: 2
  selector:
    matchLabels:
      app: order-api
  template:
    metadata:
      labels:
        app: order-api
    spec:
      containers:
        - name: order-api
          image: ${IMAGE}
          ports:
            - containerPort: 8000
              name: http
          envFrom:
            - secretRef:
                name: app-db
          env:
            - name: POOL_MIN_SIZE
              value: "2"
            - name: POOL_MAX_SIZE
              value: "10"
            - name: COMMAND_TIMEOUT
              value: "5"
            - name: FAILURE_RATE
              value: "0"
          readinessProbe:
            httpGet:
              path: /health
              port: 8000
            initialDelaySeconds: 3
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /health
              port: 8000
            initialDelaySeconds: 10
            periodSeconds: 15
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
---
apiVersion: v1
kind: Service
metadata:
  name: order-api
  namespace: shop
spec:
  selector:
    app: order-api
  ports:
    - name: http
      port: 80
      targetPort: 8000
