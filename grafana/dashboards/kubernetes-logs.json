{
  "uid": "obs-k8s-logs",
  "title": "Kubernetes Logs",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(namespace)"
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(pod)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "All pod logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{namespace=~\"$namespace\", pod=~\"$pod\"}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Errors",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{namespace=~\"$namespace\"} |= \"ERROR\""
        }
      ]
    },
    {
      "id": 3,
      "title": "Log volume by pod",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (pod) (count_over_time({namespace=~\"$namespace\"}[1m]))"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
